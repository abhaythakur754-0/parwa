# ─────────────────────────────────────────────────────────────
# PARWA Backend — Render.com Production Environment
# ─────────────────────────────────────────────────────────────
# Set these in Render Dashboard → Environment → Add Environment Variable
# DO NOT commit actual secrets — use Render's encrypted env vars
# ─────────────────────────────────────────────────────────────

# ─── APPLICATION ─────────────────────────────────────────────
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_48
DEBUG=false
APP_VERSION=0.1.0

# ─── DATABASE (Supabase PostgreSQL) ──────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ─── REDIS (Upstash) ────────────────────────────────────────
# Get from: Upstash Dashboard → your Redis instance → Details
# Format: rediss://default:TOKEN@region-xyz.upstash.io:PORT
REDIS_URL=rediss://default:TOKEN@region.upstash.io:6379
REDIS_PASSWORD=TOKEN_FROM_UPSTASH

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM APIs ────────────────────────────────────────────────
LLM_PROVIDER=litellm
LLM_PRIMARY_PROVIDER=google
LLM_FALLBACK_PROVIDER=groq
GOOGLE_AI_API_KEY=YOUR_GOOGLE_AI_KEY
CEREBRAS_API_KEY=YOUR_CEREBRAS_KEY
GROQ_API_KEY=YOUR_GROQ_KEY

# ─── GOOGLE OAUTH ────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ─── PAYMENTS (PADDLE) ──────────────────────────────────────
PADDLE_CLIENT_TOKEN=YOUR_PADDLE_CLIENT_TOKEN
PADDLE_API_KEY=YOUR_PADDLE_API_KEY
PADDLE_WEBHOOK_SECRET=YOUR_PADDLE_WEBHOOK_SECRET
PADDLE_PRICE_IDS={"mini_parwa":"pri_xxx","parwa":"pri_xxx","parwa_high":"pri_xxx"}

# ─── ENCRYPTION (MUST be 32 chars) ──────────────────────────
DATA_ENCRYPTION_KEY=CHANGE_ME_exactly_32_chars!!
PRICING_SIGNING_KEY=CHANGE_ME_generate_with_openssl_rand
REFRESH_TOKEN_PEPPER=CHANGE_ME_generate_random_string

# ─── EMAIL (Brevo) ───────────────────────────────────────────
BREVO_API_KEY=YOUR_BREVO_API_KEY
FROM_EMAIL=noreply@parwa.ai

# ─── SMS/VOICE (Twilio) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── STORAGE ─────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# ─── CORS ────────────────────────────────────────────────────
# Your Vercel frontend URL
CORS_ORIGINS=https://your-vercel-app.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app
CSRF_ENABLED=true

# ─── NEXTAUTH ────────────────────────────────────────────────
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
NEXTAUTH_URL=https://your-vercel-app.vercel.app
NEXT_PUBLIC_PADDLE_KEY=YOUR_PADDLE_PUBLIC_KEY

# ─── CELERY ──────────────────────────────────────────────────
# Same Upstash Redis URL but different database number
CELERY_BROKER_URL=rediss://default:TOKEN@region.upstash.io:6379/1
CELERY_RESULT_BACKEND=rediss://default:TOKEN@region.upstash.io:6379/2

# ─── PORT (Render sets this automatically) ──────────────────
PORT=10000
