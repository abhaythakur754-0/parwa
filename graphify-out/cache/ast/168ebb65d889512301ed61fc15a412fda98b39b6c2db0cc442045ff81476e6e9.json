ld import and use require_platform_admin.", "file_type": "rationale", "source_file": "backend/tests/security_day1_complete.py", "source_location": "L45"}, {"id": "tests_security_day1_complete_rationale_59", "label": "C-11: Billing status endpoint requires platform_admin authentication.", "file_type": "rationale", "source_file": "backend/tests/security_day1_complete.py", "source_location": "L59"}, {"id": "tests_security_day1_complete_rationale_62", "label": "Billing status endpoint must have authentication.", "file_type": "rationale", "source_file": "backend/tests/security_day1_complete.py", "source_location": "L62"}, {"id": "tests_security_day1_complete_rationale_69", "label": "Billing status must NOT be publicly accessible.", "file_type": "rationale", "source_file": "backend/tests/security_day1_complete.py", "source_location": "L69"}, {"id": "tests_security_day1_complete_rationale_87", "label": "C-12: RAG operations must use JWT-derived company_id, not client-supplied.", "file_type": "rationale", "source_file": "backend/tests/security_day1_complete.py", "source_location": "L87"}, {"id": "tests_security_day1_complete_rationale_90", "label": "rag_search uses get_company_id dependency, not body.get('company_id').", "file_type": "rationale", "source_file": "backend/tests/security_day1_complete.py", "source_location": "L90"}, {"id": "tests_security_day1_complete_rationale_100", "label": "GET /documents checks path company_id vs JWT company_id.", "file_type": "rationale", "source_file": "backend/tests/security_day1_complete.py", "source_location": "L100"}, {"id": "tests_security_day1_complete_rationale_108", "label": "get_company_id extracts company_id from user object, not request body.", "file_type": "rationale", "source_file": "backend/tests/security_day1_complete.py", "source_location": "L108"}, {"id": "tests_security_day1_complete_rationale_119", "label": "C-09: MFA verify endpoint uses temporary MFA session token, not JWT.", "file_type": "rationale", "source_file":