# ─────────────────────────────────────────────────────────────
# PARWA — Next.js Production Environment
# Used by the frontend build (NEXT_PUBLIC_ vars are baked in at build time)
# For runtime server-side vars, use .env.prod
# ─────────────────────────────────────────────────────────────

# Public API URL (baked into client-side JS at build time)
NEXT_PUBLIC_API_URL=https://parwa.ai

# Paddle public key (client-side only, safe to expose)
NEXT_PUBLIC_PADDLE_KEY=

# Environment indicator
NEXT_PUBLIC_ENV=production

# App version (auto-detected from package.json)
NEXT_PUBLIC_APP_VERSION=0.1.0

# Sentry DSN (client-side, safe to expose)
NEXT_PUBLIC_SENTRY_DSN=

# ── Server-side only (NOT exposed to browser) ──
# These are available at runtime in the standalone server
SERVER_API_URL=http://backend:8000

# NextAuth (required for NextAuth.js in production)
NEXTAUTH_SECRET=CHANGE_ME_generate_with_python_secrets_token_urlsafe_48
NEXTAUTH_URL=https://parwa.ai
