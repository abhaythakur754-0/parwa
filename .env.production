# ─────────────────────────────────────────────────────────────
# PARWA — Vercel (Frontend) Production Environment
# NEXT_PUBLIC_ vars are baked into client-side JS at build time
# ─────────────────────────────────────────────────────────────

# Backend API URL — points to your Render backend
# Replace YOUR-RENDER-APP with your actual Render app name
NEXT_PUBLIC_API_URL=https://parwa-backend.onrender.com

# WebSocket URL for Socket.io (points to Render backend)
NEXT_PUBLIC_WS_URL=wss://parwa-backend.onrender.com

# Paddle public key (client-side only, safe to expose)
NEXT_PUBLIC_PADDLE_KEY=

# Environment indicator
NEXT_PUBLIC_ENV=production

# App version
NEXT_PUBLIC_APP_VERSION=0.1.0

# Sentry DSN (client-side, safe to expose)
NEXT_PUBLIC_SENTRY_DSN=

# ── Server-side only (NOT exposed to browser) ──
# These are available at runtime in the Vercel serverless functions

# NextAuth
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
NEXTAUTH_URL=https://your-vercel-app.vercel.app

# Backend URL for server-side API calls (bypasses CORS)
SERVER_API_URL=https://parwa-backend.onrender.com
