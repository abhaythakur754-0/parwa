# ─────────────────────────────────────────────────────────────
# PARWA — Next.js Production Environment
# Used by the frontend build (NEXT_PUBLIC_ vars are baked in at build time)
# For runtime server-side vars, use Vercel Environment Variables
# ─────────────────────────────────────────────────────────────

# Public API URL (baked into client-side JS at build time)
# This is used by the frontend API client (axios) for direct API calls.
# Set to empty string so the client uses relative URLs (which hit our proxy routes).
NEXT_PUBLIC_API_URL=

# Backend URL for server-side proxy routes (NOT baked into client JS)
# This is used by API route handlers to proxy requests to the actual backend.
BACKEND_URL=https://parwa-backend.onrender.com

# Google OAuth Client ID (baked into client-side JS)
# Get one from https://console.cloud.google.com/apis/credentials
# IMPORTANT: Set this in Vercel Environment Variables (takes precedence over this file)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id_here

# Paddle public key (client-side only, safe to expose)
NEXT_PUBLIC_PADDLE_KEY=

# Environment indicator
NEXT_PUBLIC_ENV=production

# App version
NEXT_PUBLIC_APP_VERSION=0.1.0

# Frontend URL for proxy Origin header (must match backend's CSRF_TRUSTED_ORIGINS)
# The deployed backend trusts https://parwa.buzz — using any other domain
# causes a 403 CSRF rejection on auth endpoints (register/login).
FRONTEND_URL=https://parwa.buzz

# ── Server-side only (NOT exposed to browser) ──
JWT_SECRET_KEY=change-me-in-vercel-dashboard
