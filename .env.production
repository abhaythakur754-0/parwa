# ─────────────────────────────────────────────────────────────
# PARWA — Vercel (Frontend) Production Environment
# NEXT_PUBLIC_ vars are baked into client-side JS at build time
# Secrets should be set in Vercel Dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Backend API URL — points to your Render backend
NEXT_PUBLIC_API_URL=https://parwa-backend.onrender.com

# WebSocket URL for Socket.io (points to Render backend)
NEXT_PUBLIC_WS_URL=wss://parwa-backend.onrender.com

# Google OAuth (client-side, safe to expose)
# Set in Vercel Dashboard: NEXT_PUBLIC_GOOGLE_CLIENT_ID

# Paddle public key (client-side only, safe to expose)
# Set in Vercel Dashboard: NEXT_PUBLIC_PADDLE_KEY

# JWT algorithm
NEXT_PUBLIC_JWT_ALGORITHM=HS256

# Environment indicator
NEXT_PUBLIC_ENV=production

# App version
NEXT_PUBLIC_APP_VERSION=0.1.0

# Sentry DSN (client-side, safe to expose)
NEXT_PUBLIC_SENTRY_DSN=

# ── Server-side only (NOT exposed to browser) ──
# Set ALL of these in Vercel Dashboard → Settings → Environment Variables
# DO NOT put actual secrets in this file — GitHub push protection will block it

# NextAuth — set in Vercel Dashboard:
# NEXTAUTH_SECRET=<your-secret>
NEXTAUTH_URL=https://parwa.buzz

# Google OAuth (server-side) — set in Vercel Dashboard:
# GOOGLE_CLIENT_ID=<your-client-id>
# GOOGLE_CLIENT_SECRET=<your-client-secret>

# Backend URL for server-side API calls (bypasses CORS)
SERVER_API_URL=https://parwa-backend.onrender.com

# LLM API keys for Jarvis local fallback — set in Vercel Dashboard:
# GOOGLE_AI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
