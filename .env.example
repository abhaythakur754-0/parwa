# ─────────────────────────────────────────────────────────────
# PARWA Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual API keys
# NEVER commit .env to Git - it contains sensitive keys!

# ─── APPLICATION ─────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=your_secret_key_here
DEBUG=true

# ─── DATABASE (Docker PostgreSQL) ────────────────────────────
POSTGRES_USER=parwa
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=parwa_db
DATABASE_URL=postgresql://parwa:your_password@localhost:5432/parwa_db
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ─── LLM APIs ────────────────────────────────────────────────
# Google AI Studio (Primary) - https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Cerebras (Fast Inference) - https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Groq (Alternative Fast) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM Provider Selection (google, cerebras, or groq)
LLM_PRIMARY_PROVIDER=google
LLM_FALLBACK_PROVIDER=groq

# ─── EMAIL (Brevo) ───────────────────────────────────────────
# Get your API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# ─── SMS/VOICE (Twilio) ──────────────────────────────────────
# Get your credentials at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
TWILIO_API_KEY=your_twilio_api_key_here
TWILIO_VOICE_WEBHOOK_URL=https://yourdomain.com/webhooks/voice

# ─── PAYMENTS (Razorpay) ────────────────────────────────────
# Get your API keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── CRM WEBHOOK SECRETS (inbound signature verification) ───
# Required in production — without these, /api/crm/webhooks/* REJECTS
# all inbound webhooks (fail-closed). Non-production accepts unverified
# webhooks with a warning.
ZENDESK_WEBHOOK_SECRET=your_zendesk_webhook_secret_here
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret_here
# Generic CRM webhooks: X-PARWA-Signature = HMAC-SHA256(secret, raw body)
CRM_WEBHOOK_SECRET=your_crm_webhook_secret_here

# ─── COMPLIANCE ──────────────────────────────────────────────
GDPR_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555
DATA_ENCRYPTION_KEY=your_32_character_encryption_key_here

# ─── FEATURE FLAGS ───────────────────────────────────────────
FEATURE_FLAGS_PATH=feature_flags

# ─── AGENT LIGHTNING ─────────────────────────────────────────
TRAINING_THRESHOLD=50

# ─── JWT (BC-011) ──────────────────────────────────────────
JWT_SECRET_KEY=your_jwt_secret_key_here

# ─── GOOGLE OAUTH ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://parwa.buzz,https://parwa.vercel.app

# ─── CELERY (Week 3: BC-004) ──────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── GCP STORAGE ──────────────────────────────────────────
GCP_STORAGE_BUCKET=your_gcp_bucket_name_here

# ─── MONITORING ───────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_DSN=
GRAFANA_API_KEY=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password_here

# ─── MCP SERVER ───────────────────────────────────────────
MCP_SERVER_URL=http://localhost:5100
MCP_AUTH_TOKEN=your_mcp_token_here

# ─── SUPABASE (frontend BFF, server-side only) ────────────
# Server-side only — used by Next.js API routes (onboarding state, kb, payments).
# NEVER expose this to the browser and NEVER hardcode it in source.
# SECURITY: the old key was committed to source — rotate it in the Supabase
# dashboard (Settings → API) before using this variable in production!
SUPABASE_SERVICE_ROLE_KEY=

# ─── NEXT.JS ──────────────────────────────────────────────
# Public API URL — baked into client JS at build time.
# Client-side axios uses relative URLs through the BFF proxy, so this
# is only used for server-side rendering.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL — used by the BFF proxy routes (server-side, runtime).
# This is the URL the Next.js API routes forward to.
# Local dev: http://localhost:8000
# Production: https://parwa-backend.onrender.com (or your backend host)
BACKEND_URL=http://localhost:8000

# ─── DEPLOYMENT ──────────────────────────────────────────
VERSION=latest

# Pricing
PRICING_SIGNING_KEY=change-this-to-a-random-64-char-string
